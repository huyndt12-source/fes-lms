rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dedicated test collection for adapter verification
    match /_adapter_test_collection/{docId} {
      allow read, write: if true;
    }

    // Default rule for application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
